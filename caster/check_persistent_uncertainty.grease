#!/usr/bin/env grease

# Capability gate for the maintained Idriç authority. Provisioning is explicit
# and separate. No application/physical answer is computed by this runner.
set -o errexit
set -o nounset
set -o pipefail
var repo = $(realpath "$(dirname "$0")/..")
var probes = "$repo/examples/autogenerated/dakota-persistent-uncertainty/probes"
var stage = "${1:-}"
if (stage === '') {
  echo 'FAIL missing stage: preflight|build|test|replay|verify-reload|constraint-effects|mutants|all'
  exit 64
}
shift
var compiler_root = get(ENV, 'DAKOTA_COMPILER_ROOT') or ''
var compiler_revision = get(ENV, 'DAKOTA_COMPILER_REVISION') or ''
var backend_root = get(ENV, 'DAKOTA_BACKEND_ROOT') or ''
var backend_revision = get(ENV, 'DAKOTA_BACKEND_REVISION') or ''
var receipts = get(ENV, 'DAKOTA_RECEIPTS') or "$repo/_/persistent-uncertainty"
var fixture = ''
var store = ''
var output = ''
var authority = 'idric'
var fallback = 'none'

while test "$#" -gt 0 {
  if test "$#" -lt 2 {
    echo "FAIL missing option value: $1"
    exit 64
  }
  case "$1" in
    --compiler-checkout)
      setvar compiler_root = "$2"
      ;;
    --compiler-revision)
      setvar compiler_revision = "$2"
      ;;
    --backend-checkout)
      setvar backend_root = "$2"
      ;;
    --backend-revision)
      setvar backend_revision = "$2"
      ;;
    --receipts)
      setvar receipts = "$2"
      ;;
    --fixture)
      setvar fixture = "$2"
      ;;
    --store)
      setvar store = "$2"
      ;;
    --output)
      setvar output = "$2"
      ;;
    --require-authority)
      setvar authority = "$2"
      ;;
    --fallback)
      setvar fallback = "$2"
      ;;
    *) echo "FAIL unknown option: $1"; exit 64 ;;
  esac
  shift 2
}

proc announce(status, message) {
  if test -t 1 {
    if (status === 'PASS') {
      printf '\033[32m%s\033[0m %s\n' "$status" "$message"
    } else {
      printf '\033[31m%s\033[0m %s\n' "$status" "$message"
    }
  } else {
    echo "$status $message"
  }
}

proc blocked(message) {
  announce BLOCKED "$message"
  exit 2
}

proc preflight {
  if (authority !== 'idric' or fallback !== 'none') {
    echo 'FAIL authority must be idric and fallback must be none'
    exit 64
  }
  for task_path in "$compiler_root" "$backend_root" "$receipts" {
    case "$task_path" in
      /*) ;;
      *) blocked "explicit absolute compiler/backend/receipt path required, received: $task_path" ;;
    esac
  }
  if ! test -x "$compiler_root/_/build/exec/idris2" {
    blocked "compiler is not built: $compiler_root/_/build/exec/idris2"
  }
  if ! test -f "$backend_root/backend/idric_x86.py" {
    blocked "checked x86 backend absent: $backend_root"
  }
  if ! test -n "$compiler_revision" {
    blocked 'explicit compiler revision required'
  }
  if ! test -n "$backend_revision" {
    blocked 'explicit backend revision required'
  }
  var actual_compiler = $(git -C "$compiler_root" rev-parse HEAD)
  var actual_backend = $(git -C "$backend_root" rev-parse HEAD)
  if (actual_compiler !== compiler_revision or actual_backend !== backend_revision) {
    blocked 'compiler/backend revision mismatch'
  }
  if ! git -C "$compiler_root" diff --quiet HEAD -- Core Compiler Idris Parser Prelude {
    blocked 'tracked compiler implementation differs from the declared pin'
  }
  if ! git -C "$backend_root" diff --quiet HEAD -- backend {
    blocked 'tracked backend implementation differs from the declared pin'
  }
  mkdir -p "$receipts"
  {
    printf 'repository_revision\t%s\n' "$(git -C "$repo" rev-parse HEAD)"
    printf 'compiler_revision\t%s\n' "$actual_compiler"
    printf 'backend_revision\t%s\n' "$actual_backend"
    printf 'host\t%s\t%s\n' "$(uname -s)" "$(uname -m)"
    printf 'authority\tidric\nfallback\tnone\n'
    sha256sum "$compiler_root/_/build/exec/idris2" \
      "$compiler_root/_/build/exec/idris2_app/idris2.so" \
      "$backend_root/backend/idric_x86.py" "$repo/caster/check_persistent_uncertainty.grease"
  } > "$receipts/identities.tsv"
  announce PASS 'preflight identities; application capabilities not yet accepted'
}

proc build {
  preflight
  printf 'probe\tcore_handoff_exit\tbackend_exit\texecution\n' > "$receipts/probes.tsv"
  var missing = 0
  for probe in RouteControl RawAcquisition InputParsing SourceIdentity FilePersistence FiniteExpression CheckedConstraint ConstraintRejection FiniteNumerics ReportRendering {
    var directory = "$receipts/$probe"
    mkdir -p "$directory"
    var source = "$probes/$probe.idric"
    # Never consume a previous attempt's executable or handoff on failure.
    rm -f "$directory/probe.one-step" "$directory/probe.elf" "$directory/execution.tsv"
    var core_status = 0
    if "$compiler_root/_/edric" --emit-one-step "$source" -o "$directory/probe.one-step" > "$directory/compiler.log" 2>&1 {
      setvar core_status = 0
    } else {
      setvar core_status = int("$?")
    }
    if (core_status !== 0) {
      printf '%s\t%s\tNOT_RUN\tNOT_RUN\n' "$probe" "$core_status" >> "$receipts/probes.tsv"
      cat "$directory/compiler.log"
      setvar missing += 1
      continue
    }
    var backend_status = 0
    # The Grease development launcher has its own Python-2 module path. It
    # must not leak that path into the pinned backend's Python-3 substrate.
    if PYTHONPATH='' python3 "$backend_root/backend/idric_x86.py" "$directory/probe.one-step" \
        --source "$source" --output "$directory/probe.elf" \
        --listing "$directory/instructions.txt" > "$directory/backend.log" 2>&1 {
      setvar backend_status = 0
    } else {
      setvar backend_status = int("$?")
    }
    if (backend_status !== 0) {
      printf '%s\t0\t%s\tNOT_RUN\n' "$probe" "$backend_status" >> "$receipts/probes.tsv"
      tail -4 "$directory/backend.log"
      setvar missing += 1
      continue
    }
    # Only closed positive controls may execute without an acquisition harness.
    if (probe === 'RouteControl' or probe === 'CheckedConstraint') {
      if "$directory/probe.elf" > "$directory/stdout" 2> "$directory/stderr" {
        var expected = 'X'
        if (probe === 'CheckedConstraint') {
          setvar expected = 'C'
        }
        var actual = $(cat "$directory/stdout")
        if (actual !== expected) {
          echo "FAIL $probe output mismatch"
          exit 1
        }
        if test -s "$directory/stderr" {
          echo "FAIL $probe unexpected stderr"
          exit 1
        }
        printf '%s\t0\t0\tPASS_CLOSED_CONTROL\n' "$probe" >> "$receipts/probes.tsv"
        sha256sum "$source" "$directory/probe.one-step" "$directory/probe.elf" > "$directory/hashes.sha256"
      } else {
        echo "FAIL $probe execution"
        exit 1
      }
    } else {
      printf '%s\t0\t0\tBLOCKED_ACQUISITION_HARNESS\n' "$probe" >> "$receipts/probes.tsv"
      setvar missing += 1
    }
  }
  cat "$receipts/probes.tsv"
  blocked 'persistent authority is not implemented: external input, finite source graph and file I/O require checked target support; closed controls do not pass acquisition'
}

case "$stage" in
  preflight) preflight ;;
  build) build ;;
  all) build; blocked 'unexecuted required acquisition, inference, reload, constraint-effects and mutant suites' ;;
  test|replay|verify-reload|constraint-effects|mutants)
    preflight
    blocked "stage $stage has no accepted persistent Idriç executable; historical/oracle receipts cannot satisfy it"
    ;;
  *) echo "FAIL unknown stage: $stage"; exit 64 ;;
esac
